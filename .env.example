# ═══════════════════════════════════════════════════════════════
# 回撤偏离监控（DeviationMonitor）配置示例
# 用法：复制本文件为同目录下的 .env，然后【手动填写】下面的值
#   cp .env.example .env
# 注意：安装脚本（deploy/install_deviation_monitor.sh）【不会修改】本文件，
#       token/标的/参数全部由你手动维护；改完保存即可，无需重装。
# ═══════════════════════════════════════════════════════════════
#
# 【密钥类配置（必填才真正推送/用微牛）】
# 微信推送 token（PushPlus，https://www.pushplus.plus 获取；留空则 --push 不发微信）
PUSHPLUS_TOKEN=
# 微牛沙盒行情密钥（可留空，美股会自动回退 yfinance）
SANDBOX_APP_KEY=
SANDBOX_APP_SECRET=
# 行情环境（只读，绝不下单）
ENVIRONMENT=sandbox
# 兼容说明：若本工程 .env 缺失某项，会自动回退读取同级 ../AutoFolio/.env（本地旧布局）；
# 自包含部署时 ../AutoFolio 不存在，此回退自动失效。

# ── 监控标的列表（必填，逗号分隔）──────────────────────────
# 两种写法都支持：
#   ① 纯代码：美股 SPY/QQQ/AAPL；A股 6 位代码自动加前缀（5/6/9→sh，0/1/2/3→sz，4/8→bj）
#   ② 混合市场前缀：us:ASHR,us:FXI,a:510900,a:512890（也接受 510900:a 反写）
DEVIATION_SYMBOLS=SPY,QQQ,600519

# ── 市场（全局默认；单标的覆盖见 DEVIATION_MARKETS）──────────
# us=美股  a=A股；命令行 --market 会覆盖这里的一切市场配置
DEVIATION_MARKET=us

# ── 单标的市场覆盖（可选；符号:市场，逗号分隔）────────────────
# 未列出的标的用上面的 DEVIATION_MARKET。示例：SPY/QQQ 用美股，600519 用 A股
DEVIATION_MARKETS=600519:a

# ── 基准价窗口：近 N 日K线最高价（全局默认 20 日）────────────
# 单标的覆盖：DEVIATION_REF_HIGH_OVERRIDES（可选，见下）
DEVIATION_REF_HIGH=20

# ── 触发阈值（默认 0.05 = 5%）：回撤 >= 该值 → 触发微信买入提示 ──
DEVIATION_DD_THRESHOLD=0.05

# ── 复位阈值（默认 0.03 = 3%）：回撤 <= 该值 → 已修复，重新武装 ──
# 硬性要求：复位阈值 必须严格小于 触发阈值（否则会变成每轮都推送）
DEVIATION_RESET_THRESHOLD=0.03

# ── 单标的覆盖（可选；符号:数值，逗号分隔）────────────────────
# 例如 SPY 用 30 日窗口、触发 6%、复位 4%；QQQ 用 10 日窗口
# DEVIATION_REF_HIGH_OVERRIDES=SPY:30,QQQ:10
# DEVIATION_DD_THRESHOLD_OVERRIDES=SPY:0.06
# DEVIATION_RESET_THRESHOLD_OVERRIDES=SPY:0.04

# ── 现价口径（可选）────────────────────────────────────────
# close = 最新K线收盘价（默认）；last = 最后一根K线收盘价（盘中即最新价）
# 日线场景下两者相同：都是「最新K线的收盘价」
DEVIATION_PRICE_FIELD=close

# ═══════════════════════════════════════════════════════════
# 推荐配置（港股 > A股，详见 PLAN_港股优先规划.md）
# 想直接用的话：把下面这些取消注释，并覆盖上面的 DEVIATION_SYMBOLS / DEVIATION_MARKET
# ═══════════════════════════════════════════════════════════
# DEVIATION_SYMBOLS=510900,513180,513530,510300,512890
# DEVIATION_MARKET=a
# DEVIATION_REF_HIGH=20
# DEVIATION_DD_THRESHOLD=0.05
# DEVIATION_RESET_THRESHOLD=0.03
# DEVIATION_REF_HIGH_OVERRIDES=513180:30,513530:30,512890:30
# DEVIATION_DD_THRESHOLD_OVERRIDES=510900:0.06,513180:0.10,513530:0.05,510300:0.05,512890:0.045
# DEVIATION_RESET_THRESHOLD_OVERRIDES=510900:0.04,513180:0.06,513530:0.03,510300:0.03,512890:0.025
